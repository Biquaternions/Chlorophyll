From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: violetc <58360096+s-yh-china@users.noreply.github.com>
Date: Fri, 17 Mar 2023 15:57:08 +0800
Subject: [PATCH] Leaves Configurable Level Vanilla Random

Biquaternions note:
This changes have been validated with a vanilla jar for 1.21.11

diff --git a/net/minecraft/world/entity/item/ItemEntity.java b/net/minecraft/world/entity/item/ItemEntity.java
index e82bb8f2d2b0e771dc371fd7e709116e1f5f204f..ec8bda93a6772f2ec5797dc59e5baa9cdfc36e0b 100644
--- a/net/minecraft/world/entity/item/ItemEntity.java
+++ b/net/minecraft/world/entity/item/ItemEntity.java
@@ -64,7 +64,10 @@ public class ItemEntity extends Entity implements TraceableEntity {
         // Paper start - Don't use level random in entity constructors (to make them thread-safe)
         this(EntityType.ITEM, level);
         this.setPos(posX, posY, posZ);
-        this.setDeltaMovement(this.random.nextDouble() * 0.2 - 0.1, 0.2, this.random.nextDouble() * 0.2 - 0.1);
+        // Chlorophyll start - Toggle Entity Level Randoms
+        net.minecraft.util.RandomSource random = me.biquaternions.chlorophyll.ChlorophyllConfig.TOGGLES.PAPER.PREVENT_LEVEL_CONSTRUCTOR_RANDOM ? this.random : level.random;
+        this.setDeltaMovement(random.nextDouble() * 0.2 - 0.1, 0.2, random.nextDouble() * 0.2 - 0.1);
+        // Chlorophyll end - Toggle Entity Level Randoms
         this.setItem(stack);
         // Paper end - Don't use level random in entity constructors
     }
diff --git a/net/minecraft/world/entity/item/PrimedTnt.java b/net/minecraft/world/entity/item/PrimedTnt.java
index 910e7739aea98d6dfa603072acf5e9936dbb2c5e..e27578b21ba3fe9b9b403d7d459384c5c894c915 100644
--- a/net/minecraft/world/entity/item/PrimedTnt.java
+++ b/net/minecraft/world/entity/item/PrimedTnt.java
@@ -67,7 +67,10 @@ public class PrimedTnt extends Entity implements TraceableEntity {
     public PrimedTnt(Level level, double x, double y, double z, @Nullable LivingEntity owner) {
         this(EntityType.TNT, level);
         this.setPos(x, y, z);
-        double d = this.random.nextDouble() * (float) (Math.PI * 2); // Paper - Don't use level random in entity constructors
+        // Chlorophyll start - Toggle Entity Level Randoms
+        net.minecraft.util.RandomSource random = me.biquaternions.chlorophyll.ChlorophyllConfig.TOGGLES.PAPER.PREVENT_LEVEL_CONSTRUCTOR_RANDOM ? this.random : level.random;
+        double d = random.nextDouble() * (float) (Math.PI * 2); // Paper - Don't use level random in entity constructors
+        // Chlorophyll end - Toggle Entity Level Randoms
         this.setDeltaMovement(-Math.sin(d) * 0.02, 0.2F, -Math.cos(d) * 0.02);
         this.setFuse(80);
         this.xo = x;
